RESTIC_MOUNT_POINT="/mnt/backup"

# Get UUID: lsblk and sudo blkid
RESTIC_DEVICE="/dev/disk/by-uuid/your-uuid"

RESTIC_REPOSITORY="/mnt/backup/restic-repo"
RESTIC_PASSWORD_FILE="/etc/restic/pass"
RESTIC_EXCLUDE_FILE="/home/kot/projects/restic-iac/restic.exclude"

RESTIC_BACKUP_PATHS="/etc /opt/stacks"

RESTIC_KEEP_DAILY="7"
RESTIC_KEEP_WEEKLY="4"
RESTIC_KEEP_MONTHLY="6"

RESTIC_MARKER_SERVICE1="/path/to/your/service/.last-dump-is-ok"
RESTIC_MARKER_SERVICE2=""
RESTIC_MARKER_SWEVICE3=""

RESTIC_MARKER_MAX_HOURS="24"

EMAIL_RECIPIENT=""